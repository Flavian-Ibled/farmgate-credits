# Copier en .env (jamais commité). Sans DATABASE_URL, l'app utilise la base locale PGlite comme avant.

# --- Base en ligne (Supabase > Connect > "Session pooler", port 5432) ---
# DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Obligatoire avec DATABASE_URL. Générer une fois (openssl rand -hex 32) et ne JAMAIS le changer : il fixe le floutage des positions.
# FG_BLUR_SECRET=

# --- Serveur ---
# PORT=8787
# HOST=127.0.0.1
# FG_DATA_DIR=            # photos + fichiers locaux (sur l'hébergeur : un volume persistant, ex. /data)

# --- PDF des fiches (Chrome headless) ---
# FG_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# FG_WEB_URL=http://localhost:5173

# --- Achat direct (virement) ---
# FG_BANK_HOLDER=
# FG_BANK_IBAN=
# FG_BANK_BIC=
